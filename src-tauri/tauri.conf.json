{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "libellus",
  "version": "0.1.0",
  "identifier": "dev.libellus.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "libellus",
        "width": 1180,
        "height": 760,
        "minWidth": 640,
        "minHeight": 420,
        "resizable": true,
        "theme": "Dark",
        "backgroundColor": "#1a1f27"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico"]
  }
}
